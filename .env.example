# ---------------------------------------------------------------------------
# Database (libSQL — SQLite-compatible)
#
# Local development: leave DATABASE_URL unset and a SQLite file is created at
# ./data/afri.db automatically.
#
# Vercel: serverless filesystems are read-only, so a local .db file cannot be
# used in production. Point these at a Turso database (free tier is plenty);
# it is the same SQLite engine and the same SQL, so no code changes.
#   turso db create afri-inclusion
#   turso db show afri-inclusion --url
#   turso db tokens create afri-inclusion
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Admin access
#
# ADMIN_PASSWORD  the password for /admin/login
# AUTH_SECRET     random string used to sign the session cookie
#                 generate with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=change-me
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Public site URL — used for absolute Open Graph image URLs.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://afriinclusion.com
